<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1 class="centered">Movies</h1>

<table class="centered">
  <thead>
    <tr>
      <th class="<%= column_sort_class("title") %>">
        <%= link_to "Title", movies_path(sort: "title", direction: next_direction("title")) %>
        <%= current_sort_icon("title") %>
      </th>
      <th class="<%= column_sort_class("rating") %>">
      <%= link_to "Rating", movies_path(sort: "rating", direction: next_direction("rating")) %>
      <%= current_sort_icon("rating") %>
      </th>
      <th class="<%= column_sort_class("release_date") %>">
      <%= link_to "Release Date", movies_path(sort: "release_date", direction: next_direction("release_date")) %>
      <%= current_sort_icon("release_date") %>
      </th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td class="<%= column_sort_class("title") %>"><%= movie.title %></td>
        <td class="<%= column_sort_class("rating") %>"><%= movie.rating %></td>
        <td class="<%= column_sort_class("release_date") %>"><%= movie.release_date.strftime("%Y-%m-%d") %></td>
        <td>
          <%= link_to "Show this movie", movie %>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="4">Total Movies: <%= @movies.count %></td>
    </tr>
  </tfoot>
</table>
<div class="centered">
<%= link_to "New movie", new_movie_path %>
</div>
